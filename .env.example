# Turso database. On Vercel these are set by the Turso integration.
# Leave them unset locally to use a SQLite file at server/local.db instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The site calls the API at /api by default. Set to "demo" to run without an API.
# VITE_API_URL=demo

# Email confirmation + welcome email via Resend (https://resend.com).
# When both are set, referrals only count after the friend confirms their email.
# RESEND_API_KEY=
# EMAIL_FROM="Throw <hello@yourdomain.com>"

# Optional: salt for hashing visitor IPs (rate limiting). Any long random string.
# IP_HASH_SALT=

# Password for the admin dashboard at /admin. Use a long, unique one.
# ADMIN_PASSWORD=
